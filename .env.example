# Database Configuration
DATABASE_URL=postgresql://research_user:research_pass@localhost:5432/research_db

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=research_api_key

# Semantic Scholar API (free, no key needed for basic access)
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1

# arXiv API (free)
ARXIV_API_URL=https://export.arxiv.org/api/query

# Google Scholar via SerpAPI (optional, requires key for large volume)
SERPAPI_KEY=optional_serpapi_key

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
RESEARCH_QUESTION_TEMPLATE_PATH=research_machine/templates/research_question.txt
DOMAIN_KNOWLEDGE_PATH=research_machine/data/domain_knowledge.json
